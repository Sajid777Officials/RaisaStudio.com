# Browser-safe Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional compatibility aliases (use only one publishable-key variable)
# SUPABASE_ANON_KEY=your_legacy_anon_key_here
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Site metadata
PORTFOLIO_SITE_URL=https://your-domain.com
PORTFOLIO_ENABLE_ADMIN=true
PORTFOLIO_SHOW_ADMIN_LINK=true
PORTFOLIO_ENABLE_TWEAKS=false
PORTFOLIO_NO_INDEX=false
