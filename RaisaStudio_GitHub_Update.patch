+async function bodyOf(request, limit = 4 * 1024 * 1024) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) { size += chunk.length; if (size > limit) throw new Error("Fixture request too large."); chunks.push(chunk); }
+  return Buffer.concat(chunks);
+}
